{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gofer.eai/schemas/gofer-learning-trace-v1.json",
  "title": "Gofer reviewed-learning trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceId",
    "projectId",
    "host",
    "sessionId",
    "objective",
    "startedAt",
    "endedAt",
    "source",
    "events",
    "traceHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "traceId": { "type": "string", "pattern": "^trace_[a-f0-9]{32}$" },
    "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{24}$" },
    "host": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "enum": ["verified-execution-journal", "host-event-export"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sequence", "time", "type", "name", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^event_[a-f0-9]{24}$" },
          "sequence": { "type": "integer", "minimum": 1 },
          "time": { "type": "string", "format": "date-time" },
          "type": {
            "enum": [
              "lifecycle",
              "approval",
              "tool",
              "command",
              "file_change",
              "validation",
              "error",
              "message",
              "other"
            ]
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "data": { "type": "object" }
        }
      }
    },
    "traceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
