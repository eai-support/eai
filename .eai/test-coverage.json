{
  "schema": "eai.test_coverage_map.v1",
  "repositories": {
    "eai": {
      "features": [
        {
          "id": "eai-cli-command-contracts",
          "description": "CLI command contracts, local stack compatibility, and deployed read-only CLI smoke.",
          "owned_paths": [
            "src/**",
            "packages/**",
            "tests/**",
            "package.json"
          ],
          "required_repo_tests": [
            "tests/**/*.spec.ts",
            "tests/**/*.test.ts",
            "src/**/*.test.ts"
          ],
          "required_cross_service_surfaces": [
            "eai-cli"
          ],
          "required_deployed_contracts": [
            "tests/cross-service/contracts/eai-cli/describe-schema.spec.ts",
            "tests/cross-service/contracts/eai-cli/error-codes.spec.ts"
          ]
        }
      ]
    }
  }
}
