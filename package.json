{
  "name": "@eai-tools/cli",
  "version": "2.6.0",
  "description": "EAI Platform CLI — scaffold, seed, deploy, and manage vertical applications",
  "type": "module",
  "bin": {
    "eai": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e-local": "bash scripts/test-local-dedicated-tenant-lifecycle.sh",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "tsc",
    "lint:no-placeholder": "! grep -r EAI_CLI_CLIENT_ID_PLACEHOLDER src/",
    "sync:gofer": "node scripts/sync-gofer-resources.cjs",
    "prepublishOnly": "npm run sync:gofer && npm run lint:no-placeholder && npm run build && npm run lint"
  },
  "files": [
    "dist",
    "resources"
  ],
  "keywords": [
    "cli",
    "enterprise",
    "ai",
    "vertical",
    "platform",
    "eai",
    "typescript",
    "commander"
  ],
  "author": "EAI Tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eai-tools/eai-cli.git"
  },
  "homepage": "https://eai-tools.github.io/eai-cli",
  "bugs": {
    "url": "https://github.com/eai-tools/eai-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "inquirer": "^12.3.2",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "@vitest/ui": "^4.1.3",
    "eslint": "^10.0.3",
    "msw": "^2.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.3"
  }
}
