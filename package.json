{
  "name": "@eai-tools/cli",
  "version": "2.9.2",
  "description": "EAI Platform CLI — scaffold, seed, deploy, and manage vertical applications",
  "type": "module",
  "bin": {
    "eai": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e-local": "bash scripts/test-local-dedicated-tenant-lifecycle.sh",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "tsc",
    "lint:no-placeholder": "! grep -r EAI_CLI_CLIENT_ID_PLACEHOLDER src/",
    "sync:gofer": "node scripts/sync-gofer-resources.cjs",
    "sync:linked-sources": "node scripts/sync-linked-sources.js",
    "docs:release-assets": "node scripts/generate-release-docs.cjs",
    "docs:release-assets:check": "node scripts/generate-release-docs.cjs --check",
    "release:check": "bash scripts/release-preflight.sh",
    "prepublishOnly": "npm run lint:no-placeholder && npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "files": [
    "dist",
    "resources"
  ],
  "keywords": [
    "cli",
    "enterprise",
    "ai",
    "vertical",
    "platform",
    "eai",
    "typescript",
    "commander"
  ],
  "author": "EAI Tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eai-tools/eai.git"
  },
  "homepage": "https://eai-tools.github.io/eai",
  "bugs": {
    "url": "https://github.com/eai-tools/eai/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "13.1.0",
    "dotenv": "16.6.1",
    "inquirer": "12.11.1",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "@vitest/ui": "4.1.3",
    "eslint": "10.0.3",
    "msw": "2.12.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.3"
  }
}
