{
  "name": "@eai-tools/cli",
  "version": "0.1.0",
  "description": "EAI Platform CLI — scaffold, seed, deploy, and manage vertical applications",
  "type": "module",
  "bin": {
    "eai": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "enterprise",
    "ai",
    "vertical",
    "platform",
    "eai",
    "typescript",
    "commander"
  ],
  "author": "EAI Tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eai-tools/eai-cli.git"
  },
  "homepage": "https://eai-tools.github.io/eai-cli",
  "bugs": {
    "url": "https://github.com/eai-tools/eai-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "inquirer": "^12.3.2",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.0.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1"
  }
}
